*.iml
.gradle
.kotlin/
local.properties
.idea/
.DS_Store
build/
/captures
.externalNativeBuild
.cxx
*.apk
*.aab

# Signing material never belongs in a public samples repo.
*.jks
*.keystore
keystore.properties

# Local Firebase config, if you wire up Firebase for your own testing — keeps
# your Firebase project from being published to integrators.
google-services.json

# Never commit a local SDK .aar. The demo resolves the SDK from Maven; an old
# fat .aar bundles Twilio's binaries, which must not be redistributed.
demo/libs/*.aar
